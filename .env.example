# Dental MLLM Benchmark — environment variables
#
# Copy this file to `.env` in the project root and fill in your keys:
#     cp .env.example .env
#     # then edit .env
#
# `.env` is gitignored — your real keys never leave the machine.
# Values already exported in your shell take precedence over .env.

# OpenAI — required for GPT-5.4 (default pilot model)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME

# Google — required for Gemini 3.1 Pro (full experiment)
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=REPLACE_ME

# Anthropic — optional, only if you enable claude-sonnet-4.6 in config.ACTIVE_MODELS
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
